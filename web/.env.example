# Base URL of the Laravel API, used only on the server (AD8).
API_BASE_URL=http://127.0.0.1:8010/api
# Shared secret with the API (TrustBff). Must match api/.env.
BFF_SHARED_KEY=
# Name of a client-IP header set by the HOSTING PLATFORM (not the client). On Vercel: x-real-ip.
# Leave empty locally: rate limits then apply per web server (stricter).
CLIENT_IP_HEADER=
# Origin of the object storage (presigned uploads) for the Content-Security-Policy connect-src.
STORAGE_ORIGIN=http://127.0.0.1:9000

# Local development only: the sign-in code screen offers "Fill in" with the newest code from the local
# Mailpit inbox. Ignored in production builds. Codes and emails are also written to the project logs/ folder.
DEV_TOOLS=1
MAILPIT_URL=http://127.0.0.1:8025
